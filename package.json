{
  "name": "warfire-leidorasga",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @warfire/database generate",
    "db:migrate": "pnpm --filter @warfire/database migrate",
    "db:migrate:deploy": "pnpm --filter @warfire/database migrate:deploy",
    "db:seed": "pnpm --filter @warfire/database seed",
    "build:packages": "pnpm run db:generate && pnpm --filter @warfire/database build && pnpm --filter @warfire/shared build",
    "postinstall": "pnpm run build:packages",
    "playwright:install": "pnpm --filter @warfire/api exec playwright install --with-deps chromium"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
