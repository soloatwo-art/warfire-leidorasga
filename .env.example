# ---- Database ----
# Local/Docker Postgres:
POSTGRES_USER=warfire
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warfire_leidorasga
DATABASE_URL=postgresql://warfire:change-me@localhost:5432/warfire_leidorasga?schema=public
DIRECT_URL=postgresql://warfire:change-me@localhost:5432/warfire_leidorasga?schema=public
#
# Neon (Cloudflare deploy): DATABASE_URL is the pooled ("-pooler") connection
# string from the Neon dashboard, DIRECT_URL is the same but without
# "-pooler" in the host — Prisma migrations need the direct one. Both must
# end in ?sslmode=require.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/warfire_leidorasga?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/warfire_leidorasga?sslmode=require

# ---- Redis ----
# Local/Docker:
REDIS_URL=redis://localhost:6379
# Upstash (Cloudflare deploy): use the "rediss://" (TLS) URL from the Upstash
# dashboard, e.g. rediss://default:<password>@<endpoint>.upstash.io:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# Seed master user (hashed at seed time, change the password after first login)
MASTER_LOGIN=ryvzin
MASTER_PASSWORD=serv20589

# ---- RubinOT scraper ----
RUBINOT_BASE_URL=https://rubinot.com.br
RUBINOT_GUILD_NAME=Warfire Leidorasga
RUBINOT_SCRAPER_USER_AGENT=WarfireLeidorasgaGuildTool/1.0 (+contato: soloatwo@gmail.com)
RUBINOT_SCRAPER_MIN_DELAY_MS=1500
GUILD_SCRAPE_CRON=*/3 * * * *
WORLD_SCRAPE_CRON=*/5 * * * *
WORLDS_MONITORED=Grimoria I,Grimoria II,Grimoria III,Grimoria IV

# Shared secret for the Cloudflare Worker Cron Trigger to call /internal/sync/*
# (only needed for the Cloudflare Containers deployment; irrelevant for local/Docker)
INTERNAL_SYNC_TOKEN=change-me-generate-a-long-random-value

# ---- API ----
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
